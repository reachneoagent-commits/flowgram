{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Flowgram",
	"version": "3.0.0",
	"identifier": "com.flowgram.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"../static/fonts/atkinson/OFL.txt": "licenses/AtkinsonHyperlegible-OFL.txt",
			"../../packages/chrome-plugin/build": "browser-extension/chrome",
			"../../packages/chrome-plugin/build-firefox": "browser-extension/firefox"
		},
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5MjRFMDE0OTI3MTlDREUKUldUZW5IR1NGT0FrV1ZkV1ExZ0lCS0FoQVNOM3dXdEdZYlpSVFFHbnNiNC9kelIrQ2hEcEhkUGoK",
			"endpoints": [
				"https://github.com/reachneoagent-commits/flowgram/releases/latest/download/latest.json"
			]
		}
	}
}
