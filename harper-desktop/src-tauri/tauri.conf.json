{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Gramflow",
	"version": "3.0.14",
	"identifier": "com.gramflow.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"../static/fonts/atkinson/OFL.txt": "licenses/AtkinsonHyperlegible-OFL.txt",
			"../../packages/chrome-plugin/build": "browser-extension/chrome",
			"../../packages/chrome-plugin/build-firefox": "browser-extension/firefox",
			"engine-bundle": "engine"
		},
		"publisher": "Gramflow",
		"createUpdaterArtifacts": true,
		"macOS": {
			"signingIdentity": "-"
		},
		"windows": {
			"nsis": {
				"installerHooks": "./windows/installer-hooks.nsh"
			}
		}
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCM0Q4ODZGOUEzRDNCN0QKUldSOU96MmFiNGc5aTdiNkZvK1ZtYkJEaENIMVFpRjFkT0VyVDBiUTltSkNWajMvUXVkL043UDQK",
			"endpoints": [
				"https://github.com/reachneoagent-commits/gramflow/releases/latest/download/latest.json"
			]
		}
	}
}
