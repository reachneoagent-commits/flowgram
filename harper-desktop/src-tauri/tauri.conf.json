{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Flowgram",
	"version": "3.0.0",
	"identifier": "com.flowgram.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../build"
	},
	"app": {
		"windows": [],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"resources": {
			"../../packages/chrome-plugin/build": "browser-extension/chrome"
		},
		"createUpdaterArtifacts": true
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVFREI1NzQ2NjNFMTgyREQKUldUZGd1RmpSbGZiN3BieGRYZjUxZVhWZDRBcWVlTVlHa3BMa2tIdDZVVDFsWHUyZkplMDU1S2QK",
			"endpoints": [
				"https://writewithharper.com/download-harper-desktop/{{target}}/{{arch}}/{{current_version}}"
			]
		}
	}
}
