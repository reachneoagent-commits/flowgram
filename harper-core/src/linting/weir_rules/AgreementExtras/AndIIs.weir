expr main <(* and I is), (is)>

let message "Use a plural verb after `and I`."
let description "A compound subject such as `he and I` is plural."
let kind "Agreement"
let becomes "are"

test "He and I is ready." "He and I are ready."
test "She and I is ready." "She and I are ready."
test "You and I is ready." "You and I are ready."
test "They and I is ready." "They and I are ready."
test "Sam and I is ready." "Sam and I are ready."
test "Maria and I is ready." "Maria and I are ready."
test "Dad and I is ready." "Dad and I are ready."
test "Mom and I is ready." "Mom and I are ready."
test "Ann and I is ready." "Ann and I are ready."
test "Tom and I is ready." "Tom and I are ready."
test "he and I is friends." "he and I are friends."
test "You and I is the team." "You and I are the team."
test "Tom and I is going." "Tom and I are going."
test "Ann and I is next." "Ann and I are next."
test "Kim and I is here." "Kim and I are here."

allows "He and I are ready."
allows "I am ready."
allows "You and I are friends."
allows "She and I agree."
allows "Sam and I went home."
allows "He and I were late."
