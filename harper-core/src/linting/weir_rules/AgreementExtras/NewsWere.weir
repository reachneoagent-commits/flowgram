expr main <(news were), (were)>

let message "`News` is singular."
let description "`News` takes a singular verb."
let kind "Agreement"
let becomes "was"
let strategy "MatchCase"

test "The news were shocking." "The news was shocking."
test "News were good today." "News was good today."
test "The news were bad." "The news was bad."
test "The news were good." "The news was good."
test "The news were clear." "The news was clear."
test "The news were out." "The news was out."
test "The news were late." "The news was late."
test "The news were old." "The news was old."
test "The news were new." "The news was new."
test "The news were big." "The news was big."
test "The news were sad." "The news was sad."
test "The news were true." "The news was true."
test "The news were false." "The news was false."
test "That news were unexpected." "That news was unexpected."

allows "The news is shocking."
allows "The news was good."
allows "No news is good news."
allows "I read the news."
allows "News travels fast."
allows "Good news, everyone."
