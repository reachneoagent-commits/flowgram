expr main <(news are), (are)>

let message "`News` is singular."
let description "`News` takes a singular verb."
let kind "Agreement"
let becomes "is"
let strategy "MatchCase"

test "The news are shocking." "The news is shocking."
test "News are good today." "News is good today."
test "The news are bad." "The news is bad."
test "The news are good." "The news is good."
test "The news are clear." "The news is clear."
test "The news are out." "The news is out."
test "The news are late." "The news is late."
test "The news are old." "The news is old."
test "The news are new." "The news is new."
test "The news are big." "The news is big."
test "The news are sad." "The news is sad."
test "The news are true." "The news is true."
test "The news are false." "The news is false."
test "That news are unexpected." "That news is unexpected."

allows "The news is shocking."
allows "The news was good."
allows "No news is good news."
allows "I read the news."
allows "News travels fast."
allows "Good news, everyone."
