expr main <(* and I was), (was)>

let message "Use a plural verb after `and I`."
let description "A compound subject such as `he and I` is plural."
let kind "Agreement"
let becomes "were"

test "He and I was late." "He and I were late."
test "She and I was late." "She and I were late."
test "You and I was late." "You and I were late."
test "They and I was late." "They and I were late."
test "Sam and I was late." "Sam and I were late."
test "Maria and I was late." "Maria and I were late."
test "Dad and I was late." "Dad and I were late."
test "Mom and I was late." "Mom and I were late."
test "Ann and I was late." "Ann and I were late."
test "Tom and I was late." "Tom and I were late."
test "he and I was friends." "he and I were friends."
test "You and I was the team." "You and I were the team."
test "Tom and I was going." "Tom and I were going."
test "Ann and I was next." "Ann and I were next."
test "Kim and I was here." "Kim and I were here."

allows "He and I were late."
allows "I was late."
allows "You and I were friends."
allows "She and I agreed."
allows "Sam and I went home."
allows "He and I are ready."
