expr main <(doggy dog world), (doggy dog world)>

let message "Did you mean `dog-eat-dog world`?"
let description "The saying is `dog-eat-dog world`."
let kind "Spelling"
let becomes "dog-eat-dog world"
let strategy "MatchCase"

test "It is a doggy dog world." "It is a dog-eat-dog world."
test "This is a doggy dog world." "This is a dog-eat-dog world."
test "That is a doggy dog world." "That is a dog-eat-dog world."
test "Business is a doggy dog world." "Business is a dog-eat-dog world."
test "It's a doggy dog world out there." "It's a dog-eat-dog world out there."
test "A doggy dog world indeed." "A dog-eat-dog world indeed."
test "Welcome to the doggy dog world." "Welcome to the dog-eat-dog world."
test "Sales is a doggy dog world." "Sales is a dog-eat-dog world."
test "It's such a doggy dog world." "It's such a dog-eat-dog world."
test "This doggy dog world is hard." "This dog-eat-dog world is hard."
test "A doggy dog world, truly." "A dog-eat-dog world, truly."
test "Life is a doggy dog world." "Life is a dog-eat-dog world."
test "It was a doggy dog world." "It was a dog-eat-dog world."
test "In a doggy dog world, adapt." "In a dog-eat-dog world, adapt."

allows "It's a dog-eat-dog world."
allows "The doggy bag was full."
allows "A dog world exists."
allows "My dog is fun."
allows "The doggy door is open."
allows "Dogs rule the world."
