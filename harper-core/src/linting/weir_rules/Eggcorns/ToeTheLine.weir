expr main <(tow the line), (tow)>

let message "Did you mean `toe the line`?"
let description "The idiom comes from standing with toes at a line: `toe the line`."
let kind "Spelling"
let becomes "toe"
let strategy "MatchCase"

test "You must tow the line." "You must toe the line."
test "He must tow the line." "He must toe the line."
test "She must tow the line." "She must toe the line."
test "We must tow the line." "We must toe the line."
test "They must tow the line." "They must toe the line."
test "Tow the line or leave." "Toe the line or leave."
test "He refused to tow the line." "He refused to toe the line."
test "Please tow the line." "Please toe the line."
test "They tow the line here." "They toe the line here."
test "Learn to tow the line." "Learn to toe the line."
test "I tow the line daily." "I toe the line daily."
test "We always tow the line." "We always toe the line."
test "Will you tow the line?" "Will you toe the line?"
test "She would tow the line." "She would toe the line."
test "Staff tow the line." "Staff toe the line."

allows "He must toe the line."
allows "We tow the car."
allows "Tow the boat home."
allows "The line is long."
allows "Toe the line."
