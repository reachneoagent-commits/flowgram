expr main <(scott free), (scott free)>

let message "Did you mean `scot-free`?"
let description "`Scot-free` means unpunished; it has nothing to do with a person named Scott."
let kind "Spelling"
let becomes "scot-free"
let strategy "MatchCase"

test "He got off scott free." "He got off scot-free."
test "She got off scott free." "She got off scot-free."
test "They got off scott free." "They got off scot-free."
test "We got off scott free." "We got off scot-free."
test "Nobody got off scott free." "Nobody got off scot-free."
test "He walked away scott free." "He walked away scot-free."
test "She went scott free." "She went scot-free."
test "They escaped scott free." "They escaped scot-free."
test "Nobody gets off scott free." "Nobody gets off scot-free."
test "He left scott free." "He left scot-free."
test "Out scott free!" "Out scot-free!"
test "They went home scott free." "They went home scot-free."
test "She got away scott free." "She got away scot-free."
test "He is free, scott free." "He is free, scot-free."
test "Off scott free." "Off scot-free."

allows "He got off scot-free."
allows "Scott is free tonight."
allows "Scott went home."
allows "Call Scott soon."
allows "Scott and I left."
allows "Scott's free time ended."
