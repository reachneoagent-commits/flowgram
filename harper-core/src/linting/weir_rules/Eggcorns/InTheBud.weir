expr main <([nip, nips, nipped, nipping] [it, them, this, that, problems] in the butt), (butt)>

let message "Did you mean `nip it in the bud`?"
let description "The idiom refers to pinching off a bud: `nip it in the bud`."
let kind "Spelling"
let becomes "bud"
let strategy "MatchCase"

test "Nip it in the butt early." "Nip it in the bud early."
test "Nip them in the butt early." "Nip them in the bud early."
test "Nip this in the butt early." "Nip this in the bud early."
test "Nip that in the butt early." "Nip that in the bud early."
test "We must nip it in the butt." "We must nip it in the bud."
test "Nip problems in the butt." "Nip problems in the bud."
test "Let's nip this in the butt now." "Let's nip this in the bud now."
test "Nip it in the butt, fast." "Nip it in the bud, fast."
test "I nip it in the butt." "I nip it in the bud."
test "She nipped it in the butt." "She nipped it in the bud."
test "Try to nip it in the butt." "Try to nip it in the bud."
test "Nip that in the butt today." "Nip that in the bud today."
test "They nip them in the butt." "They nip them in the bud."
test "We nip this in the butt together." "We nip this in the bud together."
test "Please nip it in the butt." "Please nip it in the bud."

allows "Nip it in the bud."
allows "He fell on his butt."
allows "A cigarette butt lay there."
allows "The bud opened."
allows "Nip the stem."
allows "A rose bud grew."
