expr main <([look, looks, looked, looking] forward <(to visit), (visit)>), (visit)>

let message "After `look forward to`, use `visiting`."
let description "In `look forward to`, the word `to` is a preposition, so a verb after it ends in `ing`."
let kind "Grammar"
let becomes "visiting"

test "I look forward to visit you." "I look forward to visiting you."
test "We are looking forward to visit the results." "We are looking forward to visiting the results."
test "She looks forward to visit them." "She looks forward to visiting them."
test "He looked forward to visit it." "He looked forward to visiting it."
test "They look forward to visit us soon." "They look forward to visiting us soon."
test "I really look forward to visit the team." "I really look forward to visiting the team."
test "I look forward to visit the end of it." "I look forward to visiting the end of it."
test "We look forward to visit more." "We look forward to visiting more."

allows "I look forward to visiting you."
allows "I want to visit you tomorrow."
allows "Look forward and visit it."
allows "We look forward to the visit."
allows "I look forward to your reply."
allows "I look forward to it."
