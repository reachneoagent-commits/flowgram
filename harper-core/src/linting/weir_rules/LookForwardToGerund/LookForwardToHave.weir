expr main <([look, looks, looked, looking] forward <(to have), (have)>), (have)>

let message "After `look forward to`, use `having`."
let description "In `look forward to`, the word `to` is a preposition, so a verb after it ends in `ing`."
let kind "Grammar"
let becomes "having"

test "I look forward to have you." "I look forward to having you."
test "We are looking forward to have the results." "We are looking forward to having the results."
test "She looks forward to have them." "She looks forward to having them."
test "He looked forward to have it." "He looked forward to having it."
test "They look forward to have us soon." "They look forward to having us soon."
test "I really look forward to have the team." "I really look forward to having the team."
test "I look forward to have the end of it." "I look forward to having the end of it."
test "We look forward to have more." "We look forward to having more."

allows "I look forward to having you."
allows "I want to have you tomorrow."
allows "Look forward and have it."
allows "We look forward to the have."
allows "I look forward to your reply."
allows "I look forward to it."
