expr main <([look, looks, looked, looking] forward <(to receive), (receive)>), (receive)>

let message "After `look forward to`, use `receiving`."
let description "In `look forward to`, the word `to` is a preposition, so a verb after it ends in `ing`."
let kind "Grammar"
let becomes "receiving"

test "I look forward to receive you." "I look forward to receiving you."
test "We are looking forward to receive the results." "We are looking forward to receiving the results."
test "She looks forward to receive them." "She looks forward to receiving them."
test "He looked forward to receive it." "He looked forward to receiving it."
test "They look forward to receive us soon." "They look forward to receiving us soon."
test "I really look forward to receive the team." "I really look forward to receiving the team."
test "I look forward to receive the end of it." "I look forward to receiving the end of it."
test "We look forward to receive more." "We look forward to receiving more."

allows "I look forward to receiving you."
allows "I want to receive you tomorrow."
allows "Look forward and receive it."
allows "We look forward to the receive."
allows "I look forward to your reply."
allows "I look forward to it."
