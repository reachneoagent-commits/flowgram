expr main <([look, looks, looked, looking] forward <(to meet), (meet)>), (meet)>

let message "After `look forward to`, use `meeting`."
let description "In `look forward to`, the word `to` is a preposition, so a verb after it ends in `ing`."
let kind "Grammar"
let becomes "meeting"

test "I look forward to meet you." "I look forward to meeting you."
test "We are looking forward to meet the results." "We are looking forward to meeting the results."
test "She looks forward to meet them." "She looks forward to meeting them."
test "He looked forward to meet it." "He looked forward to meeting it."
test "They look forward to meet us soon." "They look forward to meeting us soon."
test "I really look forward to meet the team." "I really look forward to meeting the team."
test "I look forward to meet the end of it." "I look forward to meeting the end of it."
test "We look forward to meet more." "We look forward to meeting more."

allows "I look forward to meeting you."
allows "I want to meet you tomorrow."
allows "Look forward and meet it."
allows "We look forward to the meet."
allows "I look forward to your reply."
allows "I look forward to it."
