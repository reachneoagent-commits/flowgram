expr main <([look, looks, looked, looking] forward <(to spend), (spend)>), (spend)>

let message "After `look forward to`, use `spending`."
let description "In `look forward to`, the word `to` is a preposition, so a verb after it ends in `ing`."
let kind "Grammar"
let becomes "spending"

test "I look forward to spend you." "I look forward to spending you."
test "We are looking forward to spend the results." "We are looking forward to spending the results."
test "She looks forward to spend them." "She looks forward to spending them."
test "He looked forward to spend it." "He looked forward to spending it."
test "They look forward to spend us soon." "They look forward to spending us soon."
test "I really look forward to spend the team." "I really look forward to spending the team."
test "I look forward to spend the end of it." "I look forward to spending the end of it."
test "We look forward to spend more." "We look forward to spending more."

allows "I look forward to spending you."
allows "I want to spend you tomorrow."
allows "Look forward and spend it."
allows "We look forward to the spend."
allows "I look forward to your reply."
allows "I look forward to it."
