expr main <([look, looks, looked, looking] forward <(to go), (go)>), (go)>

let message "After `look forward to`, use `going`."
let description "In `look forward to`, the word `to` is a preposition, so a verb after it ends in `ing`."
let kind "Grammar"
let becomes "going"

test "I look forward to go you." "I look forward to going you."
test "We are looking forward to go the results." "We are looking forward to going the results."
test "She looks forward to go them." "She looks forward to going them."
test "He looked forward to go it." "He looked forward to going it."
test "They look forward to go us soon." "They look forward to going us soon."
test "I really look forward to go the team." "I really look forward to going the team."
test "I look forward to go the end of it." "I look forward to going the end of it."
test "We look forward to go more." "We look forward to going more."

allows "I look forward to going you."
allows "I want to go you tomorrow."
allows "Look forward and go it."
allows "We look forward to the go."
allows "I look forward to your reply."
allows "I look forward to it."
