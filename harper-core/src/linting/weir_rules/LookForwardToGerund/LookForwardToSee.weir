expr main <([look, looks, looked, looking] forward <(to see), (see)>), (see)>

let message "After `look forward to`, use `seeing`."
let description "In `look forward to`, the word `to` is a preposition, so a verb after it ends in `ing`."
let kind "Grammar"
let becomes "seeing"

test "I look forward to see you." "I look forward to seeing you."
test "We are looking forward to see the results." "We are looking forward to seeing the results."
test "She looks forward to see them." "She looks forward to seeing them."
test "He looked forward to see it." "He looked forward to seeing it."
test "They look forward to see us soon." "They look forward to seeing us soon."
test "I really look forward to see the team." "I really look forward to seeing the team."
test "I look forward to see the end of it." "I look forward to seeing the end of it."
test "We look forward to see more." "We look forward to seeing more."

allows "I look forward to seeing you."
allows "I want to see you tomorrow."
allows "Look forward and see it."
allows "We look forward to the see."
allows "I look forward to your reply."
allows "I look forward to it."
