expr main <([look, looks, looked, looking] forward <(to work), (work)>), (work)>

let message "After `look forward to`, use `working`."
let description "In `look forward to`, the word `to` is a preposition, so a verb after it ends in `ing`."
let kind "Grammar"
let becomes "working"

test "I look forward to work you." "I look forward to working you."
test "We are looking forward to work the results." "We are looking forward to working the results."
test "She looks forward to work them." "She looks forward to working them."
test "He looked forward to work it." "He looked forward to working it."
test "They look forward to work us soon." "They look forward to working us soon."
test "I really look forward to work the team." "I really look forward to working the team."
test "I look forward to work the end of it." "I look forward to working the end of it."
test "We look forward to work more." "We look forward to working more."

allows "I look forward to working you."
allows "I want to work you tomorrow."
allows "Look forward and work it."
allows "We look forward to the work."
allows "I look forward to your reply."
allows "I look forward to it."
