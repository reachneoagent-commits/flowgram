expr main <([look, looks, looked, looking] forward <(to join), (join)>), (join)>

let message "After `look forward to`, use `joining`."
let description "In `look forward to`, the word `to` is a preposition, so a verb after it ends in `ing`."
let kind "Grammar"
let becomes "joining"

test "I look forward to join you." "I look forward to joining you."
test "We are looking forward to join the results." "We are looking forward to joining the results."
test "She looks forward to join them." "She looks forward to joining them."
test "He looked forward to join it." "He looked forward to joining it."
test "They look forward to join us soon." "They look forward to joining us soon."
test "I really look forward to join the team." "I really look forward to joining the team."
test "I look forward to join the end of it." "I look forward to joining the end of it."
test "We look forward to join more." "We look forward to joining more."

allows "I look forward to joining you."
allows "I want to join you tomorrow."
allows "Look forward and join it."
allows "We look forward to the join."
allows "I look forward to your reply."
allows "I look forward to it."
