expr main <([explain, explains, explained, explaining] us [the, that, how, what, why, it, this, our, my, your]), (us)>

let message "Use `explain to us`."
let description "The verb `explain` needs `to` before the person who is told."
let kind "Grammar"
let becomes "to us"

test "Let me explain us the plan." "Let me explain to us the plan."
test "Let me explain us how it works." "Let me explain to us how it works."
test "Let me explain us what happened." "Let me explain to us what happened."
test "Let me explain us why it failed." "Let me explain to us why it failed."
test "Let me explain us it again." "Let me explain to us it again."
test "Let me explain us this clearly." "Let me explain to us this clearly."
test "Let me explain us our plan." "Let me explain to us our plan."
test "Let me explain us my idea." "Let me explain to us my idea."
test "Let me explain us your options." "Let me explain to us your options."
test "Let me explain us that now." "Let me explain to us that now."
test "I will explain us the rules." "I will explain to us the rules."
test "She explained us how." "She explained to us how."
test "Please explain us what is wrong." "Please explain to us what is wrong."
test "We can explain us why." "We can explain to us why."
test "He explains us the idea." "He explains to us the idea."

allows "Let me explain to us the plan."
allows "Explain the plan."
allows "I will explain it later."
allows "She explained the rules."
allows "We explain how it works."
allows "Please explain why."
