expr main <([explain, explains, explained, explaining] them [the, that, how, what, why, it, this, our, my, your]), (them)>

let message "Use `explain to them`."
let description "The verb `explain` needs `to` before the person who is told."
let kind "Grammar"
let becomes "to them"

test "Let me explain them the plan." "Let me explain to them the plan."
test "Let me explain them how it works." "Let me explain to them how it works."
test "Let me explain them what happened." "Let me explain to them what happened."
test "Let me explain them why it failed." "Let me explain to them why it failed."
test "Let me explain them it again." "Let me explain to them it again."
test "Let me explain them this clearly." "Let me explain to them this clearly."
test "Let me explain them our plan." "Let me explain to them our plan."
test "Let me explain them my idea." "Let me explain to them my idea."
test "Let me explain them your options." "Let me explain to them your options."
test "Let me explain them that now." "Let me explain to them that now."
test "I will explain them the rules." "I will explain to them the rules."
test "She explained them how." "She explained to them how."
test "Please explain them what is wrong." "Please explain to them what is wrong."
test "We can explain them why." "We can explain to them why."
test "He explains them the idea." "He explains to them the idea."

allows "Let me explain to them the plan."
allows "Explain the plan."
allows "I will explain it later."
allows "She explained the rules."
allows "We explain how it works."
allows "Please explain why."
