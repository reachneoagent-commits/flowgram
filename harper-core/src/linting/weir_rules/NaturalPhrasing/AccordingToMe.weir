expr main (according to [me, myself])

let message "Use `in my opinion` or `I think`."
let description "`According to` introduces another source. For your own view, say `in my opinion` or `I think`."
let kind "Style"
let becomes "in my opinion"
let strategy "MatchCase"

test "According to me, this is wrong." "In my opinion, this is wrong."
test "according to me, this is wrong." "in my opinion, this is wrong."
test "According to me, we should go." "In my opinion, we should go."
test "According to me, it works." "In my opinion, it works."
test "According to me this fails." "In my opinion this fails."
test "According to me, he is right." "In my opinion, he is right."
test "It is, according to me, fine." "It is, in my opinion, fine."
test "According to me it is late." "In my opinion it is late."
test "According to me, she won." "In my opinion, she won."
test "According to me, the plan is good." "In my opinion, the plan is good."
test "According to me, that is false." "In my opinion, that is false."
test "According to me, try again." "In my opinion, try again."
test "According to me, it's fine." "In my opinion, it's fine."
test "According to me, we are done." "In my opinion, we are done."

allows "According to the report, sales rose."
allows "According to her, it works."
allows "In my opinion, it works."
allows "According to Maria, we go."
allows "According to them, no."
allows "I think it works."
