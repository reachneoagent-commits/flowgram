expr main <([explain, explains, explained, explaining] me [the, that, how, what, why, it, this, our, my, your]), (me)>

let message "Use `explain to me`."
let description "The verb `explain` needs `to` before the person who is told."
let kind "Grammar"
let becomes "to me"

test "Let me explain me the plan." "Let me explain to me the plan."
test "Let me explain me how it works." "Let me explain to me how it works."
test "Let me explain me what happened." "Let me explain to me what happened."
test "Let me explain me why it failed." "Let me explain to me why it failed."
test "Let me explain me it again." "Let me explain to me it again."
test "Let me explain me this clearly." "Let me explain to me this clearly."
test "Let me explain me our plan." "Let me explain to me our plan."
test "Let me explain me my idea." "Let me explain to me my idea."
test "Let me explain me your options." "Let me explain to me your options."
test "Let me explain me that now." "Let me explain to me that now."
test "I will explain me the rules." "I will explain to me the rules."
test "She explained me how." "She explained to me how."
test "Please explain me what is wrong." "Please explain to me what is wrong."
test "We can explain me why." "We can explain to me why."
test "He explains me the idea." "He explains to me the idea."

allows "Let me explain to me the plan."
allows "Explain the plan."
allows "I will explain it later."
allows "She explained the rules."
allows "We explain how it works."
allows "Please explain why."
