expr main <([explain, explains, explained, explaining] you [the, that, how, what, why, it, this, our, my, your]), (you)>

let message "Use `explain to you`."
let description "The verb `explain` needs `to` before the person who is told."
let kind "Grammar"
let becomes "to you"

test "Let me explain you the plan." "Let me explain to you the plan."
test "Let me explain you how it works." "Let me explain to you how it works."
test "Let me explain you what happened." "Let me explain to you what happened."
test "Let me explain you why it failed." "Let me explain to you why it failed."
test "Let me explain you it again." "Let me explain to you it again."
test "Let me explain you this clearly." "Let me explain to you this clearly."
test "Let me explain you our plan." "Let me explain to you our plan."
test "Let me explain you my idea." "Let me explain to you my idea."
test "Let me explain you your options." "Let me explain to you your options."
test "Let me explain you that now." "Let me explain to you that now."
test "I will explain you the rules." "I will explain to you the rules."
test "She explained you how." "She explained to you how."
test "Please explain you what is wrong." "Please explain to you what is wrong."
test "We can explain you why." "We can explain to you why."
test "He explains you the idea." "He explains to you the idea."

allows "Let me explain to you the plan."
allows "Explain the plan."
allows "I will explain it later."
allows "She explained the rules."
allows "We explain how it works."
allows "Please explain why."
