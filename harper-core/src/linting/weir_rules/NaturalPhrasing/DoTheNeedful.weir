expr main <([do, does, did, doing] the needful), (the needful)>

let message "`Do the needful` sounds dated in American English."
let description "Say `do what is needed` or just describe the action."
let kind "Style"
let becomes "what is needed"
let strategy "MatchCase"

test "Please do the needful." "Please do what is needed."
test "Kindly do the needful." "Kindly do what is needed."
test "Could you do the needful?" "Could you do what is needed?"
test "Please do the needful today." "Please do what is needed today."
test "I will do the needful." "I will do what is needed."
test "He will do the needful soon." "He will do what is needed soon."
test "Do the needful." "Do what is needed."
test "They do the needful." "They do what is needed."
test "We did the needful." "We did what is needed."
test "He does the needful." "He does what is needed."
test "Can you do the needful?" "Can you do what is needed?"
test "Kindly do the needful now." "Kindly do what is needed now."
test "She can do the needful." "She can do what is needed."
test "Let's do the needful." "Let's do what is needed."
test "Please do the needful by noon." "Please do what is needed by noon."
test "Do the needful quickly." "Do what is needed quickly."

allows "Please do what is needed."
allows "Do the work."
allows "I will do it."
allows "He did the needed work."
allows "Do the dishes."
allows "We do the laundry."
