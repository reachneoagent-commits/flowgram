expr main <([explain, explains, explained, explaining] him [the, that, how, what, why, it, this, our, my, your]), (him)>

let message "Use `explain to him`."
let description "The verb `explain` needs `to` before the person who is told."
let kind "Grammar"
let becomes "to him"

test "Let me explain him the plan." "Let me explain to him the plan."
test "Let me explain him how it works." "Let me explain to him how it works."
test "Let me explain him what happened." "Let me explain to him what happened."
test "Let me explain him why it failed." "Let me explain to him why it failed."
test "Let me explain him it again." "Let me explain to him it again."
test "Let me explain him this clearly." "Let me explain to him this clearly."
test "Let me explain him our plan." "Let me explain to him our plan."
test "Let me explain him my idea." "Let me explain to him my idea."
test "Let me explain him your options." "Let me explain to him your options."
test "Let me explain him that now." "Let me explain to him that now."
test "I will explain him the rules." "I will explain to him the rules."
test "She explained him how." "She explained to him how."
test "Please explain him what is wrong." "Please explain to him what is wrong."
test "We can explain him why." "We can explain to him why."
test "He explains him the idea." "He explains to him the idea."

allows "Let me explain to him the plan."
allows "Explain the plan."
allows "I will explain it later."
allows "She explained the rules."
allows "We explain how it works."
allows "Please explain why."
