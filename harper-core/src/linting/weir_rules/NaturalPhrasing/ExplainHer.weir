expr main <([explain, explains, explained, explaining] her [the, that, how, what, why, it, this, our, my, your]), (her)>

let message "Use `explain to her`."
let description "The verb `explain` needs `to` before the person who is told."
let kind "Grammar"
let becomes "to her"

test "Let me explain her the plan." "Let me explain to her the plan."
test "Let me explain her how it works." "Let me explain to her how it works."
test "Let me explain her what happened." "Let me explain to her what happened."
test "Let me explain her why it failed." "Let me explain to her why it failed."
test "Let me explain her it again." "Let me explain to her it again."
test "Let me explain her this clearly." "Let me explain to her this clearly."
test "Let me explain her our plan." "Let me explain to her our plan."
test "Let me explain her my idea." "Let me explain to her my idea."
test "Let me explain her your options." "Let me explain to her your options."
test "Let me explain her that now." "Let me explain to her that now."
test "I will explain her the rules." "I will explain to her the rules."
test "She explained her how." "She explained to her how."
test "Please explain her what is wrong." "Please explain to her what is wrong."
test "We can explain her why." "We can explain to her why."
test "He explains her the idea." "He explains to her the idea."

allows "Let me explain to her the plan."
allows "Explain the plan."
allows "I will explain it later."
allows "She explained the rules."
allows "We explain how it works."
allows "Please explain why."
