expr main (usual custom)

let message "`usual custom` is redundant. Use `custom`."
let description "Removes the redundant word in `usual custom`."
let kind "Redundancy"
let becomes "custom"
let strategy "MatchCase"

test "The usual custom is clear." "The custom is clear."
test "I think the usual custom was important." "I think the custom was important."
test "We discussed the usual custom yesterday." "We discussed the custom yesterday."
test "Nobody noticed the usual custom." "Nobody noticed the custom."
test "She wrote about the usual custom again." "She wrote about the custom again."
test "Usual custom came up in the meeting." "Custom came up in the meeting."
test "They talked about usual custom for hours." "They talked about custom for hours."
test "It was usual custom, as expected." "It was custom, as expected."
test "He thought about usual custom for a while." "He thought about custom for a while."
test "There was no usual custom here." "There was no custom here."
test "Her usual custom surprised us." "Her custom surprised us."
test "Mention the usual custom to them." "Mention the custom to them."

allows "The custom is clear."
allows "I think the custom was important."
allows "We discussed the custom yesterday."
allows "Nobody noticed the custom."
allows "She wrote about the custom again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
