expr main (new innovation)

let message "`new innovation` is redundant. Use `innovation`."
let description "Removes the redundant word in `new innovation`."
let kind "Redundancy"
let becomes "innovation"
let strategy "MatchCase"

test "The new innovation is clear." "The innovation is clear."
test "I think the new innovation was important." "I think the innovation was important."
test "We discussed the new innovation yesterday." "We discussed the innovation yesterday."
test "Nobody noticed the new innovation." "Nobody noticed the innovation."
test "She wrote about the new innovation again." "She wrote about the innovation again."
test "New innovation came up in the meeting." "Innovation came up in the meeting."
test "They talked about new innovation for hours." "They talked about innovation for hours."
test "It was new innovation, as expected." "It was innovation, as expected."
test "He thought about new innovation for a while." "He thought about innovation for a while."
test "There was no new innovation here." "There was no innovation here."
test "Her new innovation surprised us." "Her innovation surprised us."
test "Mention the new innovation to them." "Mention the innovation to them."

allows "The innovation is clear."
allows "I think the innovation was important."
allows "We discussed the innovation yesterday."
allows "Nobody noticed the innovation."
allows "She wrote about the innovation again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
