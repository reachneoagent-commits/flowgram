expr main (merge together)

let message "`merge together` is redundant. Use `merge`."
let description "Removes the redundant word in `merge together`."
let kind "Redundancy"
let becomes "merge"
let strategy "MatchCase"

test "We will merge together the files." "We will merge the files."
test "Please merge together the pieces." "Please merge the pieces."
test "They want to merge together soon." "They want to merge soon."
test "I need to merge together now." "I need to merge now."
test "Can you merge together them?" "Can you merge them?"
test "Merge together the two groups." "Merge the two groups."
test "He asked us to merge together everything." "He asked us to merge everything."
test "She likes to merge together early." "She likes to merge early."
test "We should merge together before noon." "We should merge before noon."
test "You can merge together later." "You can merge later."
test "Try to merge together today." "Try to merge today."
test "They will merge together next week." "They will merge next week."

allows "We will merge the files."
allows "Please merge the pieces."
allows "They want to merge soon."
allows "I need to merge now."
allows "Can you merge them?"
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
