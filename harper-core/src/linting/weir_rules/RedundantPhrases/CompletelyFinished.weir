expr main (completely finished)

let message "`completely finished` is redundant. Use `finished`."
let description "Removes the redundant word in `completely finished`."
let kind "Redundancy"
let becomes "finished"
let strategy "MatchCase"

test "It is completely finished." "It is finished."
test "That was completely finished." "That was finished."
test "The result was completely finished." "The result was finished."
test "She felt completely finished." "She felt finished."
test "This seems completely finished." "This seems finished."
test "Completely finished indeed." "Finished indeed."
test "We found it completely finished." "We found it finished."
test "He called it completely finished." "He called it finished."
test "They are completely finished." "They are finished."
test "Everything looked completely finished." "Everything looked finished."
test "The plan is completely finished." "The plan is finished."
test "Honestly, it is completely finished." "Honestly, it is finished."

allows "It is finished."
allows "That was finished."
allows "The result was finished."
allows "She felt finished."
allows "This seems finished."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
