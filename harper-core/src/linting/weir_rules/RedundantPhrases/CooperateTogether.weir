expr main (cooperate together)

let message "`cooperate together` is redundant. Use `cooperate`."
let description "Removes the redundant word in `cooperate together`."
let kind "Redundancy"
let becomes "cooperate"
let strategy "MatchCase"

test "We will cooperate together the files." "We will cooperate the files."
test "Please cooperate together the pieces." "Please cooperate the pieces."
test "They want to cooperate together soon." "They want to cooperate soon."
test "I need to cooperate together now." "I need to cooperate now."
test "Can you cooperate together them?" "Can you cooperate them?"
test "Cooperate together the two groups." "Cooperate the two groups."
test "He asked us to cooperate together everything." "He asked us to cooperate everything."
test "She likes to cooperate together early." "She likes to cooperate early."
test "We should cooperate together before noon." "We should cooperate before noon."
test "You can cooperate together later." "You can cooperate later."
test "Try to cooperate together today." "Try to cooperate today."
test "They will cooperate together next week." "They will cooperate next week."

allows "We will cooperate the files."
allows "Please cooperate the pieces."
allows "They want to cooperate soon."
allows "I need to cooperate now."
allows "Can you cooperate them?"
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
