expr main (join together)

let message "`join together` is redundant. Use `join`."
let description "Removes the redundant word in `join together`."
let kind "Redundancy"
let becomes "join"
let strategy "MatchCase"

test "We will join together the files." "We will join the files."
test "Please join together the pieces." "Please join the pieces."
test "They want to join together soon." "They want to join soon."
test "I need to join together now." "I need to join now."
test "Can you join together them?" "Can you join them?"
test "Join together the two groups." "Join the two groups."
test "He asked us to join together everything." "He asked us to join everything."
test "She likes to join together early." "She likes to join early."
test "We should join together before noon." "We should join before noon."
test "You can join together later." "You can join later."
test "Try to join together today." "Try to join today."
test "They will join together next week." "They will join next week."

allows "We will join the files."
allows "Please join the pieces."
allows "They want to join soon."
allows "I need to join now."
allows "Can you join them?"
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
