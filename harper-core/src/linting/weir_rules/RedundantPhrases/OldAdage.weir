expr main (old adage)

let message "`old adage` is redundant. Use `adage`."
let description "Removes the redundant word in `old adage`."
let kind "Redundancy"
let becomes "adage"
let strategy "MatchCase"

test "The old adage is clear." "The adage is clear."
test "I think the old adage was important." "I think the adage was important."
test "We discussed the old adage yesterday." "We discussed the adage yesterday."
test "Nobody noticed the old adage." "Nobody noticed the adage."
test "She wrote about the old adage again." "She wrote about the adage again."
test "Old adage came up in the meeting." "Adage came up in the meeting."
test "They talked about old adage for hours." "They talked about adage for hours."
test "It was old adage, as expected." "It was adage, as expected."
test "He thought about old adage for a while." "He thought about adage for a while."
test "There was no old adage here." "There was no adage here."
test "Her old adage surprised us." "Her adage surprised us."
test "Mention the old adage to them." "Mention the adage to them."

allows "The adage is clear."
allows "I think the adage was important."
allows "We discussed the adage yesterday."
allows "Nobody noticed the adage."
allows "She wrote about the adage again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
