expr main (unexpected surprise)

let message "`unexpected surprise` is redundant. Use `surprise`."
let description "Removes the redundant word in `unexpected surprise`."
let kind "Redundancy"
let becomes "surprise"
let strategy "MatchCase"

test "The unexpected surprise is clear." "The surprise is clear."
test "I think the unexpected surprise was important." "I think the surprise was important."
test "We discussed the unexpected surprise yesterday." "We discussed the surprise yesterday."
test "Nobody noticed the unexpected surprise." "Nobody noticed the surprise."
test "She wrote about the unexpected surprise again." "She wrote about the surprise again."
test "Unexpected surprise came up in the meeting." "Surprise came up in the meeting."
test "They talked about unexpected surprise for hours." "They talked about surprise for hours."
test "It was unexpected surprise, as expected." "It was surprise, as expected."
test "He thought about unexpected surprise for a while." "He thought about surprise for a while."
test "There was no unexpected surprise here." "There was no surprise here."
test "Her unexpected surprise surprised us." "Her surprise surprised us."
test "Mention the unexpected surprise to them." "Mention the surprise to them."

allows "The surprise is clear."
allows "I think the surprise was important."
allows "We discussed the surprise yesterday."
allows "Nobody noticed the surprise."
allows "She wrote about the surprise again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
