expr main (free gift)

let message "`free gift` is redundant. Use `gift`."
let description "Removes the redundant word in `free gift`."
let kind "Redundancy"
let becomes "gift"
let strategy "MatchCase"

test "The free gift is clear." "The gift is clear."
test "I think the free gift was important." "I think the gift was important."
test "We discussed the free gift yesterday." "We discussed the gift yesterday."
test "Nobody noticed the free gift." "Nobody noticed the gift."
test "She wrote about the free gift again." "She wrote about the gift again."
test "Free gift came up in the meeting." "Gift came up in the meeting."
test "They talked about free gift for hours." "They talked about gift for hours."
test "It was free gift, as expected." "It was gift, as expected."
test "He thought about free gift for a while." "He thought about gift for a while."
test "There was no free gift here." "There was no gift here."
test "Her free gift surprised us." "Her gift surprised us."
test "Mention the free gift to them." "Mention the gift to them."

allows "The gift is clear."
allows "I think the gift was important."
allows "We discussed the gift yesterday."
allows "Nobody noticed the gift."
allows "She wrote about the gift again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
