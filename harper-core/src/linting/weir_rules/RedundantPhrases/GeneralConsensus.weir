expr main (general consensus)

let message "`general consensus` is redundant. Use `consensus`."
let description "Removes the redundant word in `general consensus`."
let kind "Redundancy"
let becomes "consensus"
let strategy "MatchCase"

test "The general consensus is clear." "The consensus is clear."
test "I think the general consensus was important." "I think the consensus was important."
test "We discussed the general consensus yesterday." "We discussed the consensus yesterday."
test "Nobody noticed the general consensus." "Nobody noticed the consensus."
test "She wrote about the general consensus again." "She wrote about the consensus again."
test "General consensus came up in the meeting." "Consensus came up in the meeting."
test "They talked about general consensus for hours." "They talked about consensus for hours."
test "It was general consensus, as expected." "It was consensus, as expected."
test "He thought about general consensus for a while." "He thought about consensus for a while."
test "There was no general consensus here." "There was no consensus here."
test "Her general consensus surprised us." "Her consensus surprised us."
test "Mention the general consensus to them." "Mention the consensus to them."

allows "The consensus is clear."
allows "I think the consensus was important."
allows "We discussed the consensus yesterday."
allows "Nobody noticed the consensus."
allows "She wrote about the consensus again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
