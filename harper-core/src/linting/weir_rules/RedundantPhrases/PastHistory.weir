expr main (past history)

let message "`past history` is redundant. Use `history`."
let description "Removes the redundant word in `past history`."
let kind "Redundancy"
let becomes "history"
let strategy "MatchCase"

test "The past history is clear." "The history is clear."
test "I think the past history was important." "I think the history was important."
test "We discussed the past history yesterday." "We discussed the history yesterday."
test "Nobody noticed the past history." "Nobody noticed the history."
test "She wrote about the past history again." "She wrote about the history again."
test "Past history came up in the meeting." "History came up in the meeting."
test "They talked about past history for hours." "They talked about history for hours."
test "It was past history, as expected." "It was history, as expected."
test "He thought about past history for a while." "He thought about history for a while."
test "There was no past history here." "There was no history here."
test "Her past history surprised us." "Her history surprised us."
test "Mention the past history to them." "Mention the history to them."

allows "The history is clear."
allows "I think the history was important."
allows "We discussed the history yesterday."
allows "Nobody noticed the history."
allows "She wrote about the history again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
