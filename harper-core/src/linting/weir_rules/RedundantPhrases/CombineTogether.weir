expr main (combine together)

let message "`combine together` is redundant. Use `combine`."
let description "Removes the redundant word in `combine together`."
let kind "Redundancy"
let becomes "combine"
let strategy "MatchCase"

test "We will combine together the files." "We will combine the files."
test "Please combine together the pieces." "Please combine the pieces."
test "They want to combine together soon." "They want to combine soon."
test "I need to combine together now." "I need to combine now."
test "Can you combine together them?" "Can you combine them?"
test "Combine together the two groups." "Combine the two groups."
test "He asked us to combine together everything." "He asked us to combine everything."
test "She likes to combine together early." "She likes to combine early."
test "We should combine together before noon." "We should combine before noon."
test "You can combine together later." "You can combine later."
test "Try to combine together today." "Try to combine today."
test "They will combine together next week." "They will combine next week."

allows "We will combine the files."
allows "Please combine the pieces."
allows "They want to combine soon."
allows "I need to combine now."
allows "Can you combine them?"
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
