expr main (repeat again)

let message "`repeat again` is redundant. Use `repeat`."
let description "Removes the redundant word in `repeat again`."
let kind "Redundancy"
let becomes "repeat"
let strategy "MatchCase"

test "We will repeat again the files." "We will repeat the files."
test "Please repeat again the pieces." "Please repeat the pieces."
test "They want to repeat again soon." "They want to repeat soon."
test "I need to repeat again now." "I need to repeat now."
test "Can you repeat again them?" "Can you repeat them?"
test "Repeat again the two groups." "Repeat the two groups."
test "He asked us to repeat again everything." "He asked us to repeat everything."
test "She likes to repeat again early." "She likes to repeat early."
test "We should repeat again before noon." "We should repeat before noon."
test "You can repeat again later." "You can repeat later."
test "Try to repeat again today." "Try to repeat today."
test "They will repeat again next week." "They will repeat next week."

allows "We will repeat the files."
allows "Please repeat the pieces."
allows "They want to repeat soon."
allows "I need to repeat now."
allows "Can you repeat them?"
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
