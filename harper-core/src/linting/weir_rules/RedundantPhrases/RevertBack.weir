expr main (revert back)

let message "`revert back` is redundant. Use `revert`."
let description "Removes the redundant word in `revert back`."
let kind "Redundancy"
let becomes "revert"
let strategy "MatchCase"

test "We will revert back the files." "We will revert the files."
test "Please revert back the pieces." "Please revert the pieces."
test "They want to revert back soon." "They want to revert soon."
test "I need to revert back now." "I need to revert now."
test "Can you revert back them?" "Can you revert them?"
test "Revert back the two groups." "Revert the two groups."
test "He asked us to revert back everything." "He asked us to revert everything."
test "She likes to revert back early." "She likes to revert early."
test "We should revert back before noon." "We should revert before noon."
test "You can revert back later." "You can revert later."
test "Try to revert back today." "Try to revert today."
test "They will revert back next week." "They will revert next week."

allows "We will revert the files."
allows "Please revert the pieces."
allows "They want to revert soon."
allows "I need to revert now."
allows "Can you revert them?"
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
