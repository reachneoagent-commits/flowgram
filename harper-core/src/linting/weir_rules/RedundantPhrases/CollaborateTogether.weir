expr main (collaborate together)

let message "`collaborate together` is redundant. Use `collaborate`."
let description "Removes the redundant word in `collaborate together`."
let kind "Redundancy"
let becomes "collaborate"
let strategy "MatchCase"

test "We will collaborate together the files." "We will collaborate the files."
test "Please collaborate together the pieces." "Please collaborate the pieces."
test "They want to collaborate together soon." "They want to collaborate soon."
test "I need to collaborate together now." "I need to collaborate now."
test "Can you collaborate together them?" "Can you collaborate them?"
test "Collaborate together the two groups." "Collaborate the two groups."
test "He asked us to collaborate together everything." "He asked us to collaborate everything."
test "She likes to collaborate together early." "She likes to collaborate early."
test "We should collaborate together before noon." "We should collaborate before noon."
test "You can collaborate together later." "You can collaborate later."
test "Try to collaborate together today." "Try to collaborate today."
test "They will collaborate together next week." "They will collaborate next week."

allows "We will collaborate the files."
allows "Please collaborate the pieces."
allows "They want to collaborate soon."
allows "I need to collaborate now."
allows "Can you collaborate them?"
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
