expr main (HIV virus)

let message "`HIV` already stands for `human immunodeficiency virus`, so `virus` is redundant."
let description "Removes `virus` after HIV."
let kind "Redundancy"
let becomes "HIV"
let strategy "MatchCase"

test "The HIV virus is clear." "The HIV is clear."
test "I think the HIV virus was important." "I think the HIV was important."
test "We discussed the HIV virus yesterday." "We discussed the HIV yesterday."
test "Nobody noticed the HIV virus." "Nobody noticed the HIV."
test "She wrote about the HIV virus again." "She wrote about the HIV again."
test "HIV virus came up in the meeting." "HIV came up in the meeting."
test "They talked about HIV virus for hours." "They talked about HIV for hours."
test "It was HIV virus, as expected." "It was HIV, as expected."
test "He thought about HIV virus for a while." "He thought about HIV for a while."
test "There was no HIV virus here." "There was no HIV here."
test "Her HIV virus surprised us." "Her HIV surprised us."
test "Mention the HIV virus to them." "Mention the HIV to them."

allows "The HIV is clear."
allows "I think the HIV was important."
allows "We discussed the HIV yesterday."
allows "Nobody noticed the HIV."
allows "She wrote about the HIV again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
