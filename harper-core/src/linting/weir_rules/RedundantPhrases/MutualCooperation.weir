expr main (mutual cooperation)

let message "`mutual cooperation` is redundant. Use `cooperation`."
let description "Removes the redundant word in `mutual cooperation`."
let kind "Redundancy"
let becomes "cooperation"
let strategy "MatchCase"

test "The mutual cooperation is clear." "The cooperation is clear."
test "I think the mutual cooperation was important." "I think the cooperation was important."
test "We discussed the mutual cooperation yesterday." "We discussed the cooperation yesterday."
test "Nobody noticed the mutual cooperation." "Nobody noticed the cooperation."
test "She wrote about the mutual cooperation again." "She wrote about the cooperation again."
test "Mutual cooperation came up in the meeting." "Cooperation came up in the meeting."
test "They talked about mutual cooperation for hours." "They talked about cooperation for hours."
test "It was mutual cooperation, as expected." "It was cooperation, as expected."
test "He thought about mutual cooperation for a while." "He thought about cooperation for a while."
test "There was no mutual cooperation here." "There was no cooperation here."
test "Her mutual cooperation surprised us." "Her cooperation surprised us."
test "Mention the mutual cooperation to them." "Mention the cooperation to them."

allows "The cooperation is clear."
allows "I think the cooperation was important."
allows "We discussed the cooperation yesterday."
allows "Nobody noticed the cooperation."
allows "She wrote about the cooperation again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
