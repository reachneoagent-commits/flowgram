expr main (sum total)

let message "`sum total` is redundant. Use `total`."
let description "Removes the redundant word in `sum total`."
let kind "Redundancy"
let becomes "total"
let strategy "MatchCase"

test "The sum total is clear." "The total is clear."
test "I think the sum total was important." "I think the total was important."
test "We discussed the sum total yesterday." "We discussed the total yesterday."
test "Nobody noticed the sum total." "Nobody noticed the total."
test "She wrote about the sum total again." "She wrote about the total again."
test "Sum total came up in the meeting." "Total came up in the meeting."
test "They talked about sum total for hours." "They talked about total for hours."
test "It was sum total, as expected." "It was total, as expected."
test "He thought about sum total for a while." "He thought about total for a while."
test "There was no sum total here." "There was no total here."
test "Her sum total surprised us." "Her total surprised us."
test "Mention the sum total to them." "Mention the total to them."

allows "The total is clear."
allows "I think the total was important."
allows "We discussed the total yesterday."
allows "Nobody noticed the total."
allows "She wrote about the total again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
