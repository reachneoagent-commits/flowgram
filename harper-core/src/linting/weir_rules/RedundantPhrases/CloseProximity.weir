expr main (close proximity)

let message "`close proximity` is redundant. Use `proximity`."
let description "Removes the redundant word in `close proximity`."
let kind "Redundancy"
let becomes "proximity"
let strategy "MatchCase"

test "The close proximity is clear." "The proximity is clear."
test "I think the close proximity was important." "I think the proximity was important."
test "We discussed the close proximity yesterday." "We discussed the proximity yesterday."
test "Nobody noticed the close proximity." "Nobody noticed the proximity."
test "She wrote about the close proximity again." "She wrote about the proximity again."
test "Close proximity came up in the meeting." "Proximity came up in the meeting."
test "They talked about close proximity for hours." "They talked about proximity for hours."
test "It was close proximity, as expected." "It was proximity, as expected."
test "He thought about close proximity for a while." "He thought about proximity for a while."
test "There was no close proximity here." "There was no proximity here."
test "Her close proximity surprised us." "Her proximity surprised us."
test "Mention the close proximity to them." "Mention the proximity to them."

allows "The proximity is clear."
allows "I think the proximity was important."
allows "We discussed the proximity yesterday."
allows "Nobody noticed the proximity."
allows "She wrote about the proximity again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
