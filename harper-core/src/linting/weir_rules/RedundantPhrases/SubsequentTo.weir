expr main (subsequent to)

let message "`subsequent to` is stiff. Use `after`."
let description "Replaces `subsequent to` with `after`."
let kind "Style"
let becomes "after"
let strategy "MatchCase"

test "We met subsequent to the meeting." "We met after the meeting."
test "Subsequent to lunch, we left." "After lunch, we left."
test "They arrived subsequent to the storm." "They arrived after the storm."
test "I called subsequent to dinner." "I called after dinner."
test "She left subsequent to the show." "She left after the show."
test "He slept subsequent to the trip." "He slept after the trip."
test "We talked subsequent to the game." "We talked after the game."
test "Subsequent to the call, I left." "After the call, I left."
test "They ate subsequent to the lecture." "They ate after the lecture."
test "I rested subsequent to work." "I rested after work."
test "Come subsequent to noon." "Come after noon."
test "We paid subsequent to delivery." "We paid after delivery."

allows "We met after the meeting."
allows "After lunch, we left."
allows "They arrived after the storm."
allows "I called after dinner."
allows "She left after the show."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
