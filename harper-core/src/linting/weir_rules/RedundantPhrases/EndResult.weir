expr main (end result)

let message "`end result` is redundant. Use `result`."
let description "Removes the redundant word in `end result`."
let kind "Redundancy"
let becomes "result"
let strategy "MatchCase"

test "The end result is clear." "The result is clear."
test "I think the end result was important." "I think the result was important."
test "We discussed the end result yesterday." "We discussed the result yesterday."
test "Nobody noticed the end result." "Nobody noticed the result."
test "She wrote about the end result again." "She wrote about the result again."
test "End result came up in the meeting." "Result came up in the meeting."
test "They talked about end result for hours." "They talked about result for hours."
test "It was end result, as expected." "It was result, as expected."
test "He thought about end result for a while." "He thought about result for a while."
test "There was no end result here." "There was no result here."
test "Her end result surprised us." "Her result surprised us."
test "Mention the end result to them." "Mention the result to them."

allows "The result is clear."
allows "I think the result was important."
allows "We discussed the result yesterday."
allows "Nobody noticed the result."
allows "She wrote about the result again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
