expr main (absolutely essential)

let message "`absolutely essential` is redundant. Use `essential`."
let description "Removes the redundant word in `absolutely essential`."
let kind "Redundancy"
let becomes "essential"
let strategy "MatchCase"

test "It is absolutely essential." "It is essential."
test "That was absolutely essential." "That was essential."
test "The result was absolutely essential." "The result was essential."
test "She felt absolutely essential." "She felt essential."
test "This seems absolutely essential." "This seems essential."
test "Absolutely essential indeed." "Essential indeed."
test "We found it absolutely essential." "We found it essential."
test "He called it absolutely essential." "He called it essential."
test "They are absolutely essential." "They are essential."
test "Everything looked absolutely essential." "Everything looked essential."
test "The plan is absolutely essential." "The plan is essential."
test "Honestly, it is absolutely essential." "Honestly, it is essential."

allows "It is essential."
allows "That was essential."
allows "The result was essential."
allows "She felt essential."
allows "This seems essential."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
