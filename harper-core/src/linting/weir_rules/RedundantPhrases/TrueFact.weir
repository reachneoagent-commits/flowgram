expr main (true fact)

let message "`true fact` is redundant. Use `fact`."
let description "Removes the redundant word in `true fact`."
let kind "Redundancy"
let becomes "fact"
let strategy "MatchCase"

test "The true fact is clear." "The fact is clear."
test "I think the true fact was important." "I think the fact was important."
test "We discussed the true fact yesterday." "We discussed the fact yesterday."
test "Nobody noticed the true fact." "Nobody noticed the fact."
test "She wrote about the true fact again." "She wrote about the fact again."
test "True fact came up in the meeting." "Fact came up in the meeting."
test "They talked about true fact for hours." "They talked about fact for hours."
test "It was true fact, as expected." "It was fact, as expected."
test "He thought about true fact for a while." "He thought about fact for a while."
test "There was no true fact here." "There was no fact here."
test "Her true fact surprised us." "Her fact surprised us."
test "Mention the true fact to them." "Mention the fact to them."

allows "The fact is clear."
allows "I think the fact was important."
allows "We discussed the fact yesterday."
allows "Nobody noticed the fact."
allows "She wrote about the fact again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
