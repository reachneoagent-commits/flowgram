expr main (until such time as)

let message "`until such time as` is wordy. Use `until`."
let description "Shortens `until such time as`."
let kind "Style"
let becomes "until"
let strategy "MatchCase"

test "We wait until such time as the vote." "We wait until the vote."
test "Stay until such time as the end." "Stay until the end."
test "Until such time as the sun sets, rest." "Until the sun sets, rest."
test "Hold on until such time as we call." "Hold on until we call."
test "Keep going until such time as we finish." "Keep going until we finish."
test "They stayed until such time as help came." "They stayed until help came."
test "I will wait until such time as you arrive." "I will wait until you arrive."
test "She slept until such time as noon." "She slept until noon."
test "Until such time as dawn, we walked." "Until dawn, we walked."
test "He read until such time as midnight." "He read until midnight."
test "We sat until such time as it ended." "We sat until it ended."
test "Pause until such time as later." "Pause until later."

allows "We wait until the vote."
allows "Stay until the end."
allows "Until the sun sets, rest."
allows "Hold on until we call."
allows "Keep going until we finish."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
