expr main (completely unanimous)

let message "`completely unanimous` is redundant. Use `unanimous`."
let description "Removes the redundant word in `completely unanimous`."
let kind "Redundancy"
let becomes "unanimous"
let strategy "MatchCase"

test "It is completely unanimous." "It is unanimous."
test "That was completely unanimous." "That was unanimous."
test "The result was completely unanimous." "The result was unanimous."
test "She felt completely unanimous." "She felt unanimous."
test "This seems completely unanimous." "This seems unanimous."
test "Completely unanimous indeed." "Unanimous indeed."
test "We found it completely unanimous." "We found it unanimous."
test "He called it completely unanimous." "He called it unanimous."
test "They are completely unanimous." "They are unanimous."
test "Everything looked completely unanimous." "Everything looked unanimous."
test "The plan is completely unanimous." "The plan is unanimous."
test "Honestly, it is completely unanimous." "Honestly, it is unanimous."

allows "It is unanimous."
allows "That was unanimous."
allows "The result was unanimous."
allows "She felt unanimous."
allows "This seems unanimous."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
