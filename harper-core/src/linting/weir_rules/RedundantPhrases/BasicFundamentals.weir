expr main (basic fundamentals)

let message "`basic fundamentals` is redundant. Use `fundamentals`."
let description "Removes the redundant word in `basic fundamentals`."
let kind "Redundancy"
let becomes "fundamentals"
let strategy "MatchCase"

test "The basic fundamentals is clear." "The fundamentals is clear."
test "I think the basic fundamentals was important." "I think the fundamentals was important."
test "We discussed the basic fundamentals yesterday." "We discussed the fundamentals yesterday."
test "Nobody noticed the basic fundamentals." "Nobody noticed the fundamentals."
test "She wrote about the basic fundamentals again." "She wrote about the fundamentals again."
test "Basic fundamentals came up in the meeting." "Fundamentals came up in the meeting."
test "They talked about basic fundamentals for hours." "They talked about fundamentals for hours."
test "It was basic fundamentals, as expected." "It was fundamentals, as expected."
test "He thought about basic fundamentals for a while." "He thought about fundamentals for a while."
test "There was no basic fundamentals here." "There was no fundamentals here."
test "Her basic fundamentals surprised us." "Her fundamentals surprised us."
test "Mention the basic fundamentals to them." "Mention the fundamentals to them."

allows "The fundamentals is clear."
allows "I think the fundamentals was important."
allows "We discussed the fundamentals yesterday."
allows "Nobody noticed the fundamentals."
allows "She wrote about the fundamentals again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
