expr main (final outcome)

let message "`final outcome` is redundant. Use `outcome`."
let description "Removes the redundant word in `final outcome`."
let kind "Redundancy"
let becomes "outcome"
let strategy "MatchCase"

test "The final outcome is clear." "The outcome is clear."
test "I think the final outcome was important." "I think the outcome was important."
test "We discussed the final outcome yesterday." "We discussed the outcome yesterday."
test "Nobody noticed the final outcome." "Nobody noticed the outcome."
test "She wrote about the final outcome again." "She wrote about the outcome again."
test "Final outcome came up in the meeting." "Outcome came up in the meeting."
test "They talked about final outcome for hours." "They talked about outcome for hours."
test "It was final outcome, as expected." "It was outcome, as expected."
test "He thought about final outcome for a while." "He thought about outcome for a while."
test "There was no final outcome here." "There was no outcome here."
test "Her final outcome surprised us." "Her outcome surprised us."
test "Mention the final outcome to them." "Mention the outcome to them."

allows "The outcome is clear."
allows "I think the outcome was important."
allows "We discussed the outcome yesterday."
allows "Nobody noticed the outcome."
allows "She wrote about the outcome again."
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
