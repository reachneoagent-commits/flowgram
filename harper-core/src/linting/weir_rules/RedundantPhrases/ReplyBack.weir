expr main (reply back)

let message "`reply back` is redundant. Use `reply`."
let description "Removes the redundant word in `reply back`."
let kind "Redundancy"
let becomes "reply"
let strategy "MatchCase"

test "We will reply back the files." "We will reply the files."
test "Please reply back the pieces." "Please reply the pieces."
test "They want to reply back soon." "They want to reply soon."
test "I need to reply back now." "I need to reply now."
test "Can you reply back them?" "Can you reply them?"
test "Reply back the two groups." "Reply the two groups."
test "He asked us to reply back everything." "He asked us to reply everything."
test "She likes to reply back early." "She likes to reply early."
test "We should reply back before noon." "We should reply before noon."
test "You can reply back later." "You can reply later."
test "Try to reply back today." "Try to reply today."
test "They will reply back next week." "They will reply next week."

allows "We will reply the files."
allows "Please reply the pieces."
allows "They want to reply soon."
allows "I need to reply now."
allows "Can you reply them?"
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
