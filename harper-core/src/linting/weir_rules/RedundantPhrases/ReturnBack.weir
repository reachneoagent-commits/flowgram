expr main (return back)

let message "`return back` is redundant. Use `return`."
let description "Removes the redundant word in `return back`."
let kind "Redundancy"
let becomes "return"
let strategy "MatchCase"

test "We will return back the files." "We will return the files."
test "Please return back the pieces." "Please return the pieces."
test "They want to return back soon." "They want to return soon."
test "I need to return back now." "I need to return now."
test "Can you return back them?" "Can you return them?"
test "Return back the two groups." "Return the two groups."
test "He asked us to return back everything." "He asked us to return everything."
test "She likes to return back early." "She likes to return early."
test "We should return back before noon." "We should return before noon."
test "You can return back later." "You can return later."
test "Try to return back today." "Try to return today."
test "They will return back next week." "They will return next week."

allows "We will return the files."
allows "Please return the pieces."
allows "They want to return soon."
allows "I need to return now."
allows "Can you return them?"
allows "The weather is nice today."
allows "Please send the report by Friday."
allows "She enjoys long walks."
