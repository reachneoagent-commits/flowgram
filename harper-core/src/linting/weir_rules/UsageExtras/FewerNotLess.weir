expr main <(less [people, items, cars, students, employees, customers, users, children, books, calls, emails, mistakes, errors, words, things, options, members, visitors, patients, players, kids, women, men]), (less)>

let message "Use `fewer` with countable things."
let description "For things you can count, use `fewer`; use `less` for amounts."
let kind "Usage"
let becomes "fewer"
let strategy "MatchCase"

test "Less people came." "Fewer people came."
test "Less items came." "Fewer items came."
test "Less cars came." "Fewer cars came."
test "Less students came." "Fewer students came."
test "Less employees came." "Fewer employees came."
test "Less customers came." "Fewer customers came."
test "Less users came." "Fewer users came."
test "Less children came." "Fewer children came."
test "Less books came." "Fewer books came."
test "Less calls came." "Fewer calls came."
test "Less emails came." "Fewer emails came."
test "Less mistakes came." "Fewer mistakes came."
test "There are less people today." "There are fewer people today."
test "We have less cars now." "We have fewer cars now."
test "Less students enrolled." "Fewer students enrolled."

allows "Fewer people came."
allows "Less water is left."
allows "We have less time."
allows "Less than ten people came."
allows "He earns less money."
allows "There is less traffic."
