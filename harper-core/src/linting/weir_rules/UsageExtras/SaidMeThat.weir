expr main <(said [me, us, him, her, them] [that, to]), (said)>

let message "Use `told` before the person addressed."
let description "You `say` something, but you `tell` someone something."
let kind "Grammar"
let becomes "told"
let strategy "MatchCase"

test "She said me that it worked." "She told me that it worked."
test "She said us that it worked." "She told us that it worked."
test "She said him that it worked." "She told him that it worked."
test "She said her that it worked." "She told her that it worked."
test "She said them that it worked." "She told them that it worked."
test "He said me to leave." "He told me to leave."
test "He said us to leave." "He told us to leave."
test "He said him to leave." "He told him to leave."
test "He said her to leave." "He told her to leave."
test "He said them to leave." "He told them to leave."
test "She said me that." "She told me that."
test "They said us that." "They told us that."
test "He said him that." "He told him that."
test "I said her to go." "I told her to go."
test "We said them that." "We told them that."

allows "She told me that it worked."
allows "She said that it worked."
allows "He said her name."
allows "She said to him that it worked."
allows "They said so."
allows "He said it to me."
