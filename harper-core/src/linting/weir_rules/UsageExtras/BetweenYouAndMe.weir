expr main <(between [you, him, her, them, us] and I), (I)>

let message "Use `me` after `between`."
let description "After a preposition like `between`, use the object pronoun `me`."
let kind "Grammar"
let becomes "me"
let strategy "Exact"

test "Between you and I, it was dull." "Between you and me, it was dull."
test "Between him and I, it was dull." "Between him and me, it was dull."
test "Between her and I, it was dull." "Between her and me, it was dull."
test "Between them and I, it was dull." "Between them and me, it was dull."
test "Between us and I, it was dull." "Between us and me, it was dull."
test "Keep it between you and I." "Keep it between you and me."
test "It is between him and I." "It is between him and me."
test "A secret between you and I." "A secret between you and me."
test "Between you and I, no." "Between you and me, no."
test "The deal is between them and I." "The deal is between them and me."
test "This stays between us and I." "This stays between us and me."
test "Between her and I, it works." "Between her and me, it works."
test "Just between you and I." "Just between you and me."
test "Between you and I we agree." "Between you and me we agree."
test "Peace between you and I." "Peace between you and me."

allows "Between you and me, no."
allows "You and I agree."
allows "He and I left."
allows "Between us, it works."
allows "You and I are friends."
allows "Call you and I will go."
