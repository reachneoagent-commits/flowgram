expr main <([is, was, were, are, been, be, being] lead by), (lead)>

let message "Use the past participle `led`."
let description "The past participle of `lead` is `led`; `lead` is the present form or a metal."
let kind "Grammar"
let becomes "led"
let strategy "MatchCase"

test "The team was lead by Maria." "The team was led by Maria."
test "The team was lead by a veteran." "The team was led by a veteran."
test "The team was lead by the founder." "The team was led by the founder."
test "The team was lead by two managers." "The team was led by two managers."
test "The team was lead by an expert." "The team was led by an expert."
test "The company is lead by a former teacher." "The company is led by a former teacher."
test "It was lead by example." "It was led by example."
test "They were lead by guides." "They were led by guides."
test "We are lead by data." "We are led by data."
test "She has been lead by instinct." "She has been led by instinct."
test "To be lead by fear is bad." "To be led by fear is bad."
test "The march was lead by students." "The march was led by students."
test "The project is lead by Sam." "The project is led by Sam."
test "The group is lead by volunteers." "The group is led by volunteers."

allows "The team was led by Maria."
allows "She will lead by example."
allows "We lead by listening."
allows "The lead by two points held."
allows "Lead pipes are old."
allows "He wants to lead by doing."
