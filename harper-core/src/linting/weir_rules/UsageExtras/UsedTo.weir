expr main <([I, he, she] use to [be, live, have, own, love, hate, like, believe, smoke, drink, date, hang]), (use)>

let message "Use `used to` for a past habit or state."
let description "A past habit is `used to`, not `use to`."
let kind "Grammar"
let becomes "used"
let strategy "MatchCase"

test "I use to be there." "I used to be there."
test "I use to live there." "I used to live there."
test "I use to have there." "I used to have there."
test "I use to own there." "I used to own there."
test "I use to love there." "I used to love there."
test "I use to hate there." "I used to hate there."
test "I use to like there." "I used to like there."
test "I use to believe there." "I used to believe there."
test "I use to smoke there." "I used to smoke there."
test "I use to drink there." "I used to drink there."
test "He use to live here." "He used to live here."
test "She use to be shy." "She used to be shy."
test "I use to date him." "I used to date him."
test "He use to own a car." "He used to own a car."
test "She use to hang out." "She used to hang out."

allows "I used to live there."
allows "I didn't use to smoke."
allows "Tools I use to build things."
allows "She uses it to read."
allows "We use to-do lists."
allows "I use it to live."
