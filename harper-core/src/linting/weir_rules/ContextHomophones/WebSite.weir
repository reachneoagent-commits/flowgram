expr main <([web, construction, building, job, historic, archaeological, landfill] cite), (cite)>

let message "Did you mean `site`?"
let description "A location or web page is a `site`; to `cite` is to quote a source."
let kind "Spelling"
let becomes "site"
let strategy "MatchCase"

test "The web cite was busy." "The web site was busy."
test "The construction cite was busy." "The construction site was busy."
test "The building cite was busy." "The building site was busy."
test "The job cite was busy." "The job site was busy."
test "The historic cite was busy." "The historic site was busy."
test "Visit our web cite." "Visit our web site."
test "The job cite opens today." "The job site opens today."
test "A historic cite nearby." "A historic site nearby."
test "The construction cite is loud." "The construction site is loud."
test "The archaeological cite is old." "The archaeological site is old."
test "The landfill cite closed." "The landfill site closed."
test "Our web cite is down." "Our web site is down."
test "The building cite is fenced." "The building site is fenced."
test "A new job cite opened." "A new job site opened."
test "The web cite loads fast." "The web site loads fast."

allows "Cite your sources."
allows "The web site loads fast."
allows "Please cite the study."
allows "The construction site is loud."
allows "He will cite the law."
allows "You must cite them."
