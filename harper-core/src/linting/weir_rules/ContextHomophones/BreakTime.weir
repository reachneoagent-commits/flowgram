expr main <([(take a), (takes a), (took a), (taken a), (taking a), (give a), (lunch), (coffee), (tea), (spring), (winter), (summer), (commercial), (bathroom), (smoke)] brake), (brake)>

let message "Did you mean `break` (a pause)?"
let description "A pause or rest is a `break`; a `brake` stops a vehicle."
let kind "Spelling"
let becomes "break"
let strategy "MatchCase"

test "Let's take a brake now." "Let's take a break now."
test "Let's take a brake soon." "Let's take a break soon."
test "Let's take a brake here." "Let's take a break here."
test "Let's take a brake today." "Let's take a break today."
test "Let's take a brake later." "Let's take a break later."
test "We took a brake." "We took a break."
test "She is taking a brake." "She is taking a break."
test "Lunch brake starts at noon." "Lunch break starts at noon."
test "Coffee brake time." "Coffee break time."
test "Summer brake is here." "Summer break is here."
test "Winter brake starts soon." "Winter break starts soon."
test "He takes a brake daily." "He takes a break daily."
test "They need a spring brake." "They need a spring break."
test "Bathroom brake please." "Bathroom break please."
test "A commercial brake followed." "A commercial break followed."

allows "Press the brake pedal."
allows "The brake light is on."
allows "She hit the brake hard."
allows "Take a break."
allows "He needs a coffee break."
allows "Check the brake fluid."
