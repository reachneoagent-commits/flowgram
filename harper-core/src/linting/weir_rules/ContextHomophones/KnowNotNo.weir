expr main <([to, don't, didn't, I, you, we, they] no [what, how, why, where, when, who, if, whether, about, everything, anything]), (no)>

let message "Did you mean `know`?"
let description "The verb is `know`; `no` is a negative word."
let kind "Spelling"
let becomes "know"
let strategy "MatchCase"

test "I want to no what." "I want to know what."
test "I want to no how." "I want to know how."
test "I want to no why." "I want to know why."
test "I want to no where." "I want to know where."
test "I want to no when." "I want to know when."
test "I want to no who." "I want to know who."
test "I want to no if." "I want to know if."
test "I want to no whether." "I want to know whether."
test "I want to no about it." "I want to know about it."
test "I want to no everything." "I want to know everything."
test "I don't no what happened." "I don't know what happened."
test "They didn't no why." "They didn't know why."
test "We no how it works." "We know how it works."
test "You no what I mean." "You know what I mean."
test "I no if it is true." "I know if it is true."

allows "I want to know what happened."
allows "No one knew why."
allows "There is no way to tell."
allows "He has no idea."
allows "No what, no how."
allows "To no avail."
