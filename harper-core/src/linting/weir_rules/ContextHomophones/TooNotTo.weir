expr main <([is, are, am, was, were, be, so, much, far, way, not] to [tired, late, early, much, many, big, small, hot, cold, fast, slow, long, short, busy, expensive, high, low, young, old, soon, hard, easy, heavy, loud, quiet, dark, bright]), (to)>

let message "Did you mean `too` (excessively)?"
let description "Use `too` to mean `excessively`; `to` is a preposition or infinitive marker."
let kind "Spelling"
let becomes "too"
let strategy "MatchCase"

test "It is to tired." "It is too tired."
test "It is to late." "It is too late."
test "It is to early." "It is too early."
test "It is to much." "It is too much."
test "It is to big." "It is too big."
test "It is to small." "It is too small."
test "It is to hot." "It is too hot."
test "It is to cold." "It is too cold."
test "It is to fast." "It is too fast."
test "It is to slow." "It is too slow."
test "It is to long." "It is too long."
test "It is to short." "It is too short."
test "He was to busy." "He was too busy."
test "They are to expensive." "They are too expensive."
test "We were to young." "We were too young."

allows "It is too late."
allows "From hot to cold."
allows "I went to bed."
allows "He wants to be early."
allows "Go from fast to slow."
allows "She came to hard terms."
