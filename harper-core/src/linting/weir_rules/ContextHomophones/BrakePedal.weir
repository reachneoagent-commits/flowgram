expr main <(break [pedal, pads, fluid, light, lights, caliper, line, lines, disc, discs, rotor, rotors]), (break)>

let message "Did you mean `brake` (the vehicle part)?"
let description "The vehicle part is a `brake`; a `break` is a pause or fracture."
let kind "Spelling"
let becomes "brake"
let strategy "MatchCase"

test "Press the break pedal." "Press the brake pedal."
test "Press the break pads." "Press the brake pads."
test "Press the break fluid." "Press the brake fluid."
test "Press the break light." "Press the brake light."
test "Press the break lights." "Press the brake lights."
test "Check the break pads." "Check the brake pads."
test "The break fluid leaked." "The brake fluid leaked."
test "Replace the break pedal." "Replace the brake pedal."
test "Break pads wear out." "Brake pads wear out."
test "The break lines are old." "The brake lines are old."
test "A break disc cracked." "A brake disc cracked."
test "The break caliper stuck." "The brake caliper stuck."
test "Inspect the break rotor." "Inspect the brake rotor."
test "The break lights failed." "The brake lights failed."
test "A break line leaked." "A brake line leaked."

allows "Take a break."
allows "Press the brake pedal."
allows "A bone break takes weeks."
allows "Break the glass."
allows "We break for lunch."
